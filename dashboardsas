function selectedStudent(data){
  const term = $("fAluno").value.toLowerCase().trim();
  if(!term) return data.length === 1 ? data[0] : null;
  return data.find(d => d.aluno.toLowerCase() === term) || data.find(d => d.aluno.toLowerCase().includes(term)) || null;
}
function weakAreaOf(d){
  if(!d) return null;
  const rows = [
    {area:"Linguagens", score:d.ac_ling, nota:d.ling},
    {area:"Humanas", score:d.ac_hum, nota:d.hum},
    {area:"Natureza", score:d.ac_nat, nota:d.nat},
    {area:"Matemática", score:d.ac_mat, nota:d.mat}
  ].filter(x=>x.score!=null || x.nota!=null);
  rows.sort((a,b)=>(a.score ?? a.nota ?? 999) - (b.score ?? b.nota ?? 999));
  return rows[0]?.area || null;
}
function priorityForQuestion(q, student){
  const pct = Number(q.percentualAcertos ?? 1);
  const weak = student ? weakAreaOf(student) : null;
  let score = 0;
  if(q.nivel === "DIFÍCIL") score += 3; else if(q.nivel === "MÉDIA") score += 2; else score += 1;
  if(q.incidencia === "Alta") score += 3; else if(q.incidencia === "Média") score += 2; else score += 1;
  if(pct < .35) score += 3; else if(pct < .55) score += 2; else score += 1;
  if(weak && q.area === weak) score += 3;
  if(score >= 10) return {label:"Muito alta", cls:"badge-red"};
  if(score >= 8) return {label:"Alta", cls:"badge-yellow"};
  if(score >= 6) return {label:"Média", cls:"badge-blue"};
  return {label:"Baixa", cls:"badge-green"};
}
function renderStudentQuestionPanel(data){
  const areaSelectForChips = document.getElementById('fAreaQuestao');
  document.querySelectorAll('.area-chip').forEach(c=>c.classList.toggle('active',(c.dataset.area||'') === (areaSelectForChips?.value||'')));
  const student = selectedStudent(data);
  const tipo = $("fTipoProva").value || "1";
  const prova = $("fProvaDia").value, area = $("fAreaQuestao").value, disc = $("fDisciplinaQuestao").value, nivel = $("fNivelQuestao").value, inc = $("fIncidenciaQuestao").value;
  const weak = weakAreaOf(student);
  $("studentPanel").innerHTML = student ? `
    <h3>Aluno selecionado</h3>
    <div class="big">${escapeHtml(student.aluno)}</div>
    <div>${escapeHtml(student.turmaMacro)} • ${escapeHtml(student.turma)}</div>
    <div class="mini-grid">
      <div class="mini-card">Média TRI<b>${fmt(student.nota)}</b></div>
      <div class="mini-card">Acertos<b>${fmt(student.acertos)}</b></div>
      <div class="mini-card">Menor área<b>${escapeHtml(weak || "-")}</b></div>
      <div class="mini-card">Tipo/cor<b>${escapeHtml(tipo)}</b></div>
    </div>` : `
    <h3>Análise individual</h3>
    <div class="big">Selecione um aluno</div>
    <div>Digite ou escolha o nome no filtro superior para cruzar o desempenho com o modelo de prova.</div>
    <div class="mini-grid"><div class="mini-card">Tipo/cor<b>${escapeHtml(tipo)}</b></div><div class="mini-card">Questões<b>${QUESTION_DATA.length}</b></div></div>`;
  let rows = QUESTION_DATA.filter(q =>
    (!tipo || q.tipoProva === tipo) &&
    (!prova || q.prova === prova) &&
    (!area || q.area === area) &&
    (!disc || q.disciplina === disc) &&
    (!nivel || q.nivel === nivel) &&
    (!inc || q.incidencia === inc)
  );
  rows = rows.map(q => ({...q, pri:priorityForQuestion(q, student)}));
  const ordenacao = $("fOrdenacaoQuestao")?.value || "numero";
  rows.sort((a,b)=>{
    if(ordenacao === "prioridade"){
      const order = {"Muito alta":4,"Alta":3,"Média":2,"Baixa":1};
      const weakDelta = student && weak && !area ? ((b.area===weak ? 1 : 0) - (a.area===weak ? 1 : 0)) : 0;
      return weakDelta || (order[b.pri.label]-order[a.pri.label]) || a.questao-b.questao;
    }
    return a.questao - b.questao;
  });
  $("questionNote").textContent = student ? `Prioridades calculadas para ${student.aluno}. Área mais frágil: ${weak || "não identificada"}.` : "Sem aluno selecionado: exibindo análise geral da prova pelo tipo/cor escolhido. A ordenação numérica mostra Linguagens da 1 à 45, Humanas da 46 à 90, Natureza da 91 à 135 e Matemática da 136 à 180.";
  const tbody = $("questionTable").querySelector("tbody");
  tbody.innerHTML = rows.length ? rows.map(q=>`
    <tr>
      <td>${escapeHtml(q.prova)}</td>
      <td><span class="badge badge-blue">${escapeHtml(q.tipoProva)}</span></td>
      <td><b>${escapeHtml(q.questao)}</b></td>
      <td>${escapeHtml(q.area)}</td>
      <td>${escapeHtml(q.disciplina)}</td>
      <td>${escapeHtml(q.conteudo || "-")}</td>
      <td>${escapeHtml(q.material || "-")}</td>
      <td>${escapeHtml(q.incidencia || "-")}</td>
      <td>${q.percentualAcertos!=null ? fmt(q.percentualAcertos*100)+"%" : "-"}</td>
      <td>${escapeHtml(q.nivel || "-")}</td>
      <td><span class="badge ${q.pri.cls}">${q.pri.label}</span></td>
    </tr>`).join("") : `<tr><td colspan="11">Nenhuma questão encontrada para os filtros.</td></tr>`;
}

function renderTable(data){
  const tbody = $("dataTable").querySelector("tbody");
  const sorted = [...data].sort((a,b)=>{
    let av = sortKey==="rank" ? a.nota : a[sortKey];
    let bv = sortKey==="rank" ? b.nota : b[sortKey];
    if(typeof av === "number" && typeof bv === "number") return (av-bv)*sortDir;
    return String(av||"").localeCompare(String(bv||""), "pt-BR")*sortDir;
  });
  const ranked = [...data].filter(d=>d.nota!=null).sort((a,b)=>b.nota-a.nota);
  const rankMap = new Map(ranked.map((d,i)=>[d.aluno+"|"+d.turmaMacro+"|"+d.turma, i+1]));
  tbody.innerHTML = sorted.map(d=>{
    const rk = rankMap.get(d.aluno+"|"+d.turmaMacro+"|"+d.turma) || "-";
    return `<tr>
      <td class="rank">${rk}</td>
      <td>${escapeHtml(d.aluno)}</td>
      <td>${escapeHtml(d.sede)}</td>
      <td>${escapeHtml(d.turmaMacro)}</td>
      <td>${escapeHtml(d.turma)}</td>
      <td><b>${fmt(d.nota)}</b></td>
      <td>${areaCell(d.ling, d.ac_ling)}</td>
      <td>${areaCell(d.hum, d.ac_hum)}</td>
      <td>${areaCell(d.nat, d.ac_nat)}</td>
      <td>${areaCell(d.mat, d.ac_mat)}</td>
      <td><b>${fmt(d.acertos)}</b></td>
      <td><span class="pill ${pillClass(d.nota)}">${faixa(d.nota)}</span></td>
    </tr>`;
  }).join("");
}

