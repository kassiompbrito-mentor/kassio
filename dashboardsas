  const wrap = document.getElementById('areaQuickFilter');
  if(!wrap) return;
  const chips = [...wrap.querySelectorAll('.area-chip')];
  chips.forEach(btn => btn.addEventListener('click', () => {
    const area = btn.dataset.area || '';
    const select = document.getElementById('fAreaQuestao');
    if(select){ select.value = area; }
    chips.forEach(c => c.classList.toggle('active', c.dataset.area === area));
    update();
  }));
  const select = document.getElementById('fAreaQuestao');
  if(select){
    select.addEventListener('change', () => {
      chips.forEach(c => c.classList.toggle('active', (c.dataset.area || '') === select.value));
    });
  }
}
initFilters();
bindAreaChips();
update();
</script>
</body>
</html>
