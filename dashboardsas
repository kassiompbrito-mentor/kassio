function barChart(id, rows, opts={}){
  const el = $(id), w = el.clientWidth || 600, h = el.clientHeight || 300;
  rows = rows.slice(0, opts.maxBars || rows.length);
  const pad = {l:42,r:18,t:20,b:62};
  const max = Math.max(1, ...rows.map(r=>r.value || 0));
  const bw = rows.length ? (w-pad.l-pad.r)/rows.length * .62 : 20;
  const gap = rows.length ? (w-pad.l-pad.r)/rows.length : 1;
  let svg = `<svg width="100%" height="100%" viewBox="0 0 ${w} ${h}" xmlns="http://www.w3.org/2000/svg">`;
  svg += `<rect x="0" y="0" width="${w}" height="${h}" fill="white"/>`;
  for(let i=0;i<=4;i++){ const y=pad.t+(h-pad.t-pad.b)*i/4; svg += `<line x1="${pad.l}" y1="${y}" x2="${w-pad.r}" y2="${y}" stroke="#EEF3F8"/>`; }
  rows.forEach((r,i)=>{
    const x = pad.l + i*gap + (gap-bw)/2;
    const bh = (h-pad.t-pad.b)*(r.value/max);
    const y = h-pad.b-bh;
    svg += `<rect x="${x}" y="${y}" width="${bw}" height="${bh}" rx="10" fill="${opts.color || '#0B3D91'}"/>`;
    svg += `<text x="${x+bw/2}" y="${y-6}" text-anchor="middle" font-size="11" font-weight="800" fill="#061B3A">${fmt(r.value)}</text>`;
    const lab = String(r.label).length > 17 ? String(r.label).slice(0,16)+"…" : r.label;
    svg += `<text x="${x+bw/2}" y="${h-34}" text-anchor="middle" font-size="11" fill="#64748B" transform="rotate(-18 ${x+bw/2} ${h-34})">${escapeHtml(lab)}</text>`;
  });
  svg += `</svg>`;
  el.innerHTML = rows.length ? svg : emptySvg(w,h);
}

function histogram(id, notas){
