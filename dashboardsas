    {label:"800+", min:800, max:1001}
  ];
  const rows = bins.map(b => ({label:b.label, value:notas.filter(n=>n>=b.min && n<b.max).length}));
  barChart(id, rows, {maxBars:5, color:"#0B3D91"});
}

