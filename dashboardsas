function faixa(n){
  if(n == null) return "Sem nota";
  if(n < 500) return "Abaixo de 500";
  if(n < 600) return "500 a 599";
  if(n < 700) return "600 a 699";
  if(n < 800) return "700 a 799";
  return "800+";
}
function faixaAcertos(n){
  if(n == null) return "Sem acertos";
  if(n < 60) return "0 a 59";
  if(n < 90) return "60 a 89";
  if(n < 120) return "90 a 119";
  if(n < 150) return "120 a 149";
  return "150+";
}
