function groupAvg(data, key, valueKey="nota"){
  const map = new Map();
  data.forEach(d => {
    const k = d[key] || "Não informado";
    const v = d[valueKey];
    if(v == null || Number.isNaN(v)) return;
    if(!map.has(k)) map.set(k, []);
    map.get(k).push(v);
  });
  return [...map.entries()].map(([label, vals]) => ({label, value: avg(vals), count: vals.length})).sort((a,b)=>b.value-a.value);
}

